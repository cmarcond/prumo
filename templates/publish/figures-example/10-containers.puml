' Example of a CONTAINERS figure (C4 level 2) — the big blocks and the flow of the data.
' Map the components of design.json: service->Container, datastore->ContainerDb,
' broker/cache/cdn->Container with a tag. Keep ~7-10 blocks per figure (legibility);
' if it goes past that, split by subsystem and use zooms (component).
@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container view — <System>

Person(user, "User")
System_Boundary(s, "<System>") {
  Container(api, "API Service", "stateless", "Control plane")
  ContainerDb(meta, "Metadata Store", "DynamoDB", "Point lookup by id")
  ContainerDb(blob, "Object Store", "S3", "Durable blobs")
  Container(edge, "CDN / Edge", "CDN", "Serves the hot content")
}

Rel(user, api, "request", "HTTPS")
Rel(api, meta, "reads/writes")
Rel(user, edge, "downloads bytes", "HTTPS")
Rel(edge, blob, "origin pull on miss")
@enduml
