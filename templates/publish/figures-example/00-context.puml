' Example of a CONTEXT figure (C4 level 1) — high level, actors + system.
' The /prumo.publish agent generates one of these from design.json (actors = client/external).
@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title Context view — <System>

Person(creator, "Creator", "Uploads content")
Person(viewer, "Viewer", "Consumes content")
System(sys, "<System>", "What we are designing")

Rel(creator, sys, "uploads", "HTTPS")
Rel(viewer, sys, "consumes", "HTTPS")
@enduml
