' Example of a COMPONENT figure (C4 level 3) — a ZOOM into a subsystem.
' Use one of these per relevant subsystem (e.g. ingestion pipeline, serving plane).
@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Zoom — <Subsystem, e.g. Ingestion Pipeline>

Container_Boundary(b, "Ingestion") {
  Component(ctrl, "Control Service", "stateless", "Validates, writes record+outbox")
  Component(disp, "Dispatcher", "CDC", "outbox -> queue; reconciles")
  Component(work, "Workers", "fleet", "Heavy processing")
}
ContainerDb(meta, "Metadata Store", "DynamoDB")
ContainerQueue(q, "Queue", "Kafka")

Rel(ctrl, meta, "record + outbox (txn)")
Rel(disp, meta, "reads outbox")
Rel(disp, q, "publishes job")
Rel(q, work, "delivers (pull)")
@enduml
