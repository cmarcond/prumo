' Example of a SEQUENCE DIAGRAM — one flow step by step (e.g. upload, watch).
' A sequence shows ORDER and ASYNCHRONY (ack before the fan-out, persist before visible).
@startuml
skinparam shadowing false
skinparam sequenceMessageAlign center
title Sequence — <Flow, e.g. Upload>

actor Creator as U
participant "Control Service" as C
database "Object Store" as O
database "Metadata Store" as M
queue "Queue" as Q

U -> C : start upload
C --> U : pre-signed URL
U -> O : PUT bytes (direct)
U -> C : finalize (idempotent)
C -> M : record + outbox (txn, conditional)
C --> U : ack 202 (before the processing)
note over C,Q : the heavy work continues asynchronously
M -> Q : (via CDC) job
@enduml
