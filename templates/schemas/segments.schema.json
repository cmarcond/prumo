{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segments.schema.json",
  "title": "Phase segmentation of a transcript (benchmark pipeline; not used by the commands)",
  "type": "object",
  "required": ["video_id", "problem_hint", "format", "phases", "anchors", "confidence"],
  "additionalProperties": true,
  "properties": {
    "video_id": {"type": "string", "minLength": 11, "maxLength": 11},
    "problem_hint": {"type": "string"},
    "format": {"type": "string", "description": "live (interspersed Q&A) | focused"},
    "phases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "start", "end"],
        "additionalProperties": true,
        "properties": {
          "phase": {"type": "string", "description": "intent|requirements|estimation|design|qa|intro|other"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "cue": {"type": "string"}
        }
      }
    },
    "anchors": {
      "type": "object",
      "description": "single-point timestamps; design_finalized_t is the key anchor for stage 08",
      "additionalProperties": true
    },
    "notes": {"type": "string"},
    "confidence": {"type": "string", "description": "high|medium|low (medium-high allowed)"}
  }
}
